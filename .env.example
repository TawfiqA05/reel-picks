# Reel Picks — API keys & config
# Copy this file to ".env" and fill in your keys. The .env file is git-ignored.

# AMC Theatres API (https://developers.amctheatres.com/). Sent as the X-AMC-Vendor-Key header.
# Note: AMC's public developer program is gated. If you don't have a key, the app still works:
# it falls back to TMDB "Now Playing" so you can rank movies, just without your theatre's exact showtimes.
AMC_API_KEY=

# TMDB API (https://www.themoviedb.org/settings/api). A v3 API key ("API Key (v3 auth)").
TMDB_API_KEY=

# OMDb API (https://www.omdbapi.com/apikey.aspx). Free tier is fine.
OMDB_API_KEY=

# Port the local server listens on.
PORT=5170

# Owner unlock for the shared tunnel (optional). Set a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Then visit  https://<your-tunnel>/?owner=THE_TOKEN  once on your phone to get
# full access (rating, watchlist, settings, stats) while friends stay read-only.
# Leave blank to disable owner unlock entirely.
OWNER_TOKEN=

# Name shown in the guest banner ("<name>'s picks — read only").
OWNER_NAME=Tawfiq
